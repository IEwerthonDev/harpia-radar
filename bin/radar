#!/usr/bin/env php
<?php

declare(strict_types=1);

use HarpiaRadar\Catalog\CatalogLoader;
use HarpiaRadar\Config\HealthConfigLoader;
use HarpiaRadar\Console\CollectCommand;
use HarpiaRadar\Console\ValidateCommand;
use HarpiaRadar\Snapshot\SnapshotWriter;
use Symfony\Component\Console\Application;
use Symfony\Component\HttpClient\HttpClient;
use Symfony\Component\HttpClient\RetryableHttpClient;

require dirname(__DIR__) . '/vendor/autoload.php';

$root = dirname(__DIR__);
$token = getenv('GITHUB_TOKEN');
$token = $token === false ? null : $token;
$catalogLoader = new CatalogLoader($root . '/schema/projects.schema.json');
// Até 3 novas tentativas em erro de rede, 429 e 5xx, respeitando Retry-After.
$httpClient = new RetryableHttpClient(HttpClient::create(), maxRetries: 3);

$application = new Application('Harpia Radar', '0.1.0');
$application->addCommand(new ValidateCommand($catalogLoader, $httpClient, $token));
$application->addCommand(new CollectCommand(
    $catalogLoader,
    new HealthConfigLoader($root . '/schema/health.schema.json'),
    new SnapshotWriter($root . '/schema/snapshot.schema.json'),
    $httpClient,
    $token,
    static fn (): DateTimeImmutable => new DateTimeImmutable('now', new DateTimeZone('UTC')),
));
$application->run();
